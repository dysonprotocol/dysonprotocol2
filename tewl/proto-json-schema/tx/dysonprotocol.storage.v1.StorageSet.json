{
    "request": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.storage.v1.MsgStorageSet",
        "definitions": {
            "dysonprotocol.storage.v1.MsgStorageSet": {
                "properties": {
                    "owner": {
                        "type": "string",
                        "description": "Account address that owns the storage entry; must be a valid bech32 address."
                    },
                    "index": {
                        "type": "string",
                        "description": "Index key for the storage entry; must be non-empty, max 128 characters, and printable ASCII only."
                    },
                    "data": {
                        "type": "string",
                        "description": "JSON data to store; size limited by MaxStorageSize parameter."
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Storage Set",
                "description": "MsgStorageSet"
            }
        }
    },
    "response": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.storage.v1.MsgStorageSetResponse",
        "definitions": {
            "dysonprotocol.storage.v1.MsgStorageSetResponse": {
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Storage Set Response",
                "description": "Empty response. See EventStorageUpdated for emitted details."
            }
        }
    }
}