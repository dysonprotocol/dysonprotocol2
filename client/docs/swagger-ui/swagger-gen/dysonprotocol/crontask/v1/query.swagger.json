    "dysonprotocol.crontask.v1.Subscription": {
      "type": "object",
      "properties": {
        "subscription_id": {
          "type": "string",
          "format": "uint64",
          "title": "unique id"
        },
        "creator": {
          "type": "string",
          "title": "creator account that owns this subscription"
        },
        "filter": {
          "type": "string",
          "title": "GJSON filter to match events across the normalized block event array"
        },
        "script_address": {
          "type": "string",
          "title": "target script address"
        },
        "function": {
          "type": "string",
          "title": "function name to invoke"
        },
        "args": {
          "type": "string",
          "title": "positional args as JSON list string"
        },
        "kwargs": {
          "type": "string",
          "title": "keyword args as JSON dict string"
        },
        "task_gas_limit": {
          "type": "string",
          "format": "uint64",
          "title": "gas limit for the created crontask"
        },
        "task_gas_fee": {
          "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
          "title": "fee for the created crontask; also charged at subscription creation/renewal"
        },
        "status": {
          "type": "string",
          "title": "status: enabled|disabled|error|expired"
        },
        "status_message": {
          "type": "string",
          "title": "status message"
        },
        "expiry_timestamp": {
          "type": "string",
          "format": "int64",
          "title": "Subscription expiry timestamp (unix seconds)"
        },
        "trigger_count": {
          "type": "string",
          "format": "uint64",
          "title": "total number of triggers so far (field name per requirement)"
        },
        "task_scheduled_timestamp": {
          "type": "string",
          "format": "int64",
          "title": "Overrides for created crontasks"
        },
        "task_expiry_timestamp": {
          "type": "string",
          "format": "int64"
        },
        "task_gas_price": {
          "$ref": "#/definitions/cosmos.base.v1beta1.DecCoin"
        }
      },
      "title": "Subscription defines an event-triggered action to execute a script"
    },
    "dysonprotocol.crontask.v1.Task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "format": "uint64",
          "title": "The unique identifier for the task"
        },
        "creator": {
          "type": "string",
          "title": "Address of the creator of the task"
        },
        "scheduled_timestamp": {
          "type": "string",
          "format": "int64",
          "title": "Unix timestamp when the task is scheduled to execute"
        },
        "expiry_timestamp": {
          "type": "string",
          "format": "int64",
          "title": "Unix timestamp after which the task will expire if not executed"
        },
        "task_gas_limit": {
          "type": "string",
          "format": "uint64",
          "title": "Maximum gas limit for the task execution"
        },
        "task_gas_price": {
          "$ref": "#/definitions/cosmos.base.v1beta1.DecCoin",
          "title": "Gas price for the task execution which is calculated automatically\nfrom task_gas_fee / task_gas_limit"
        },
        "task_gas_fee": {
          "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
          "title": "Gas fee for the task execution"
        },
        "msgs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/google.protobuf.Any"
          },
          "title": "Messages to execute as part of the task"
        },
        "msg_results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/google.protobuf.Any"
          },
          "title": "Results of message execution"
        },
        "status": {
          "type": "string",
          "title": "Current status of the task: Scheduled, Pending, Done, Failed, Expired"
        },
        "creation_time": {
          "type": "string",
          "format": "int64",
          "title": "Block timestamp when the task was created"
        },
        "error_log": {
          "type": "string",
          "title": "Error message if task execution failed"
