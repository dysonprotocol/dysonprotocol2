    "dysonprotocol.whaleswap.v1.MsgCreatePool": {
      "type": "object",
      "properties": {
        "creator": {
          "type": "string"
        },
        "coins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          },
          "description": "Two initial reserves as coins; order will be canonicalized internally (by\ndenom lexicographic order)."
        },
        "min_price": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          },
          "description": "Optional price band expressed as ratios coin2/coin1 using two coins.\nEach must either be empty (unset) or contain exactly two coins whose\ndenoms match the two pool reserve denoms."
        },
        "max_price": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          }
        },
        "fee_pct": {
          "type": "string",
          "description": "Deprecated: fee_pct is the legacy pool swap fee percentage (cosmos.Dec\nstring in [0,1)). Use fee_rate field 11 instead. Migration logic should\nread this and convert to fee_rate format (two DecCoins, one per reserve\ndenom in canonical order)."
        },
        "min_collateral_ratio": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.DecCoin"
          },
          "description": "Minimum collateral ratio per reserve denom (exactly two, canonical order).\nEach amount is a LegacyDec string (> 1)."
        },
        "max_leverage_ratio": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.DecCoin"
          },
          "description": "Maximum leverage ratio per reserve denom (exactly two, canonical order).\nEach amount is a LegacyDec string (> 1)."
        },
        "interest_rate": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.DecCoin"
          },
          "description": "Annual interest rates per reserve denom (exactly two, canonical order).\nEach amount is a LegacyDec string representing APR (per-year accrual)."
        },
        "max_borrow_percent": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.DecCoin"
          },
          "description": "Maximum borrow capacity per reserve denom as DecCoins (exactly two,\ncanonical order). Each amount is a LegacyDec in [0,1)."
        },
