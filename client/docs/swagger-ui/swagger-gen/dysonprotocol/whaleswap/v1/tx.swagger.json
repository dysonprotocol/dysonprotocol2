  "definitions": {
    "cosmos.base.v1beta1.Coin": {
      "type": "object",
      "properties": {
        "denom": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        }
      },
      "description": "Coin defines a token with a denomination and an amount.\n\nNOTE: The amount field is an Int which implements the custom method\nsignatures required by gogoproto."
    },
    "dysonprotocol.whaleswap.v1.MsgAddLiquidity": {
      "type": "object",
      "properties": {
        "signer": {
          "type": "string"
        },
        "pool_id": {
          "type": "string",
          "format": "uint64"
        },
        "amount1": {
          "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
        },
        "amount2": {
          "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
        }
      },
      "description": "Add liquidity (owner-only). Behavior depends on v2/v3 mode."
    },
    "dysonprotocol.whaleswap.v1.MsgAddLiquidityResponse": {
      "type": "object",
      "properties": {
        "shares": {
          "type": "string",
          "title": "minted shares amount (sdk.Int string)"
        }
      }
    },
    "dysonprotocol.whaleswap.v1.MsgCancelOffer": {
      "type": "object",
      "properties": {
        "closer": {
          "type": "string"
        },
        "offer_id": {
          "type": "string",
          "format": "uint64"
        }
      },
      "description": "Cancel an offer (maker or eligible third-party for liquid offers).\n\n- Maker may always cancel open offers.\n- For liquid-have offers, a third party is eligible if the maker's balance of\n  the liquid have denom drops below one unit_have, enabling recovery via\n  PFAND."
    },
    "dysonprotocol.whaleswap.v1.MsgCancelOfferResponse": {
      "type": "object"
    },
    "dysonprotocol.whaleswap.v1.MsgConvertToLiquid": {
      "type": "object",
      "properties": {
        "caller": {
          "type": "string"
        },
        "denom": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        }
      },
      "description": "Convert solid denom to liquid wrapper L(denom)."
    },
    "dysonprotocol.whaleswap.v1.MsgConvertToLiquidResponse": {
      "type": "object",
      "properties": {
        "liquid_denom": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        }
      }
    },
    "dysonprotocol.whaleswap.v1.MsgConvertToSolid": {
      "type": "object",
      "properties": {
        "caller": {
          "type": "string"
        },
        "liquid_denom": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        }
      },
      "description": "Convert liquid denom L(denom) to solid denom."
    },
    "dysonprotocol.whaleswap.v1.MsgConvertToSolidResponse": {
      "type": "object",
      "properties": {
        "amount_out": {
          "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
        }
      }
    },
    "dysonprotocol.whaleswap.v1.MsgCreatePool": {
      "type": "object",
      "properties": {
        "creator": {
          "type": "string"
        },
        "coins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          },
          "description": "Two initial reserves as coins; order will be canonicalized internally (by\ndenom lexicographic order)."
        },
        "min_price": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          },
          "description": "Optional price band expressed as ratios coin2/coin1 using two coins.\nEach must either be empty (unset) or contain exactly two coins whose\ndenoms match the two pool reserve denoms."
        },
        "max_price": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          }
        },
        "fee_pct": {
          "type": "string"
        }
      },
      "description": "Create a pool.\n\nBehavior:\n- If min_price/max_price are both unset (or effectively encode [0, +\u221e)), the\n  pool behaves as constant product (v2).\n- If a finite band is provided, concentrated-liquidity math applies within\n  [min_price, max_price] where price is coin_b / coin_a (see conventions)."
    },
    "dysonprotocol.whaleswap.v1.MsgCreatePoolResponse": {
      "type": "object",
      "properties": {
        "pool_id": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "dysonprotocol.whaleswap.v1.MsgMakeOffer": {
      "type": "object",
      "properties": {
        "maker": {
          "type": "string"
        },
        "have": {
          "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
        },
        "want": {
          "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
        }
      },
      "description": "Make an orderbook offer.\n\nConstraints and semantics:\n- have and want must be different denoms and strictly positive.\n- want denom must be a solid denom; liquid want is disallowed.\n- If have denom is liquid, the transaction locks PFAND per module params.\n- The keeper computes GCD(have.amount, want.amount) to establish integral\n  units for partial fills: unit_have = have/gcd, unit_want = want/gcd.\n- RemainingUnits starts at gcd and decreases as fills occur."
    },
    "dysonprotocol.whaleswap.v1.MsgMakeOfferResponse": {
      "type": "object",
      "properties": {
        "offer_id": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "dysonprotocol.whaleswap.v1.MsgOpenAuction": {
      "type": "object",
      "properties": {
        "seller": {
          "type": "string"
        },
        "bid_denom": {
          "type": "string"
        },
        "sell": {
          "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
          "description": "Explicit solid sell coin to escrow from seller \u2192 module."
        }
      },
      "description": "Open an auction by escrowing exactly one solid denom amount.\n\n- The escrowed `sell` coin is transferred from seller to module and marked by\n  an NFT for redemption logic. `bid_denom` defines the quote asset."
    },
    "dysonprotocol.whaleswap.v1.MsgOpenAuctionResponse": {
      "type": "object",
      "properties": {
        "auction_id": {
          "type": "string",
          "format": "uint64"
        }
      }
    },
    "dysonprotocol.whaleswap.v1.MsgPoolSwap": {
      "type": "object",
      "properties": {
        "trader": {
          "type": "string"
        },
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          },
          "description": "Total allowed debits from the trader by denom, enforced at end only."
        },
        "legs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dysonprotocol.whaleswap.v1.SwapLeg"
          },
          "description": "Arbitrary set of swap legs; order does not need to be contiguous by denom."
        },
        "min_output": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          },
          "description": "Final minimum outputs required per denom after aggregation."
        }
      },
      "description": "Single-pool swap.\n\n- `input` denom must be one of the pool reserves; `out_denom` must be the\n  other.\n- `minimum_out_amount` is an sdk.Int string; the swap fails if the computed\n  output is less than this value after fees."
    },
    "dysonprotocol.whaleswap.v1.MsgPoolSwapResponse": {
      "type": "object",
      "properties": {
        "amount_out": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          }
        }
      }
    },
    "dysonprotocol.whaleswap.v1.MsgRedeemAuction": {
      "type": "object",
      "properties": {
        "caller": {
          "type": "string"
        },
        "auction_id": {
          "type": "string",
          "format": "uint64"
        }
      },
      "description": "Redeem auction escrow by NFT owner when no current bidder exists."
    },
    "dysonprotocol.whaleswap.v1.MsgRedeemAuctionResponse": {
      "type": "object"
    },
    "dysonprotocol.whaleswap.v1.MsgRemoveLiquidity": {
      "type": "object",
      "properties": {
        "signer": {
          "type": "string"
        },
        "pool_id": {
          "type": "string",
          "format": "uint64"
        },
        "shares": {
          "type": "string",
          "title": "shares to burn (sdk.Int string)"
        }
      },
      "description": "Remove liquidity (anyone). Must respect price band and produce non-zero\noutputs."
    },
    "dysonprotocol.whaleswap.v1.MsgRemoveLiquidityResponse": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          },
          "title": "coins returned"
        }
      }
    },
    "dysonprotocol.whaleswap.v1.MsgTakeOffer": {
      "type": "object",
      "properties": {
        "taker": {
          "type": "string"
        },
        "trades": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dysonprotocol.whaleswap.v1.TakeItem"
          }
        }
      }
    },
    "dysonprotocol.whaleswap.v1.MsgTakeOfferResponse": {
      "type": "object",
      "properties": {
        "sent": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          },
          "description": "Total coins the taker sent across executed trades (usually want denom)."
        },
        "received": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          },
          "description": "Total coins the taker received across executed trades (usually have denom,\nbase denom when offers use liquid have)."
        }
      }
    },
    "dysonprotocol.whaleswap.v1.MsgUpdateParams": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "string"
        },
        "params": {
          "$ref": "#/definitions/dysonprotocol.whaleswap.v1.Params"
        }
      },
      "description": "UpdateParams is the Msg/UpdateParams request type."
    },
    "dysonprotocol.whaleswap.v1.MsgUpdateParamsResponse": {
      "type": "object"
    },
    "dysonprotocol.whaleswap.v1.MsgUpdatePoolConfig": {
      "type": "object",
      "properties": {
        "signer": {
          "type": "string"
        },
        "pool_id": {
          "type": "string",
          "format": "uint64"
        },
        "fee_pct": {
          "type": "string",
          "title": "Optional fields; empty string means no change"
        },
        "min_price": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          }
        },
        "max_price": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          }
        }
      },
      "description": "Update pool config (owner-only: majority of shares > 50%).\n\nNotes:\n- Empty string/empty arrays indicate no change for that field.\n- Price bands follow the same two-coin ratio rules as in MsgCreatePool."
    },
    "dysonprotocol.whaleswap.v1.MsgUpdatePoolConfigResponse": {
      "type": "object"
    },
    "dysonprotocol.whaleswap.v1.Params": {
      "type": "object",
      "properties": {
        "pfand_per_offer": {
          "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
          "description": "pfand_per_offer is the PFAND coin required for liquid-mode offers."
        },
        "valuation_fee_pct": {
          "type": "string",
          "description": "valuation_fee_pct is the percentage applied per valuation_period."
        },
