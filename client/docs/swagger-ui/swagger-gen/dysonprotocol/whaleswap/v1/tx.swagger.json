        }
      }
    },
    "dysonprotocol.whaleswap.v1.MsgCancelOffer": {
      "type": "object",
      "properties": {
        "closer": {
          "type": "string"
        },
        "offer_id": {
          "type": "string",
          "format": "uint64"
        }
      },
      "description": "Cancel an offer (maker or eligible third-party for liquid-mode offers).\n\n- Maker may always cancel open offers.\n- For liquid-mode offers, a third party is eligible if the maker's balance of\n  the have denom drops below one unit_have, enabling recovery via PFAND."
    },
    "dysonprotocol.whaleswap.v1.MsgCancelOfferResponse": {
      "type": "object"
    },
