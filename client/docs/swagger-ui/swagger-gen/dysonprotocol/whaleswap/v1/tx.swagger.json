    "dysonprotocol.whaleswap.v1.MsgAddLiquidity": {
      "type": "object",
      "properties": {
        "signer": {
          "type": "string"
        },
        "pool_id": {
          "type": "string",
          "format": "uint64"
        },
        "amounts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
          },
          "description": "Amounts to add (two coins in any order; will be canonicalized)."
        }
      },
      "description": "Add liquidity (owner-only). Behavior depends on v2/v3 mode.\nAmounts will be automatically sorted by denom to match pool's canonical\norder."
    },
    "dysonprotocol.whaleswap.v1.MsgAddLiquidityResponse": {
      "type": "object",
