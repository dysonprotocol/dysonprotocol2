{
    "request": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.script.v1.QueryEncodeJsonRequest",
        "definitions": {
            "dysonprotocol.script.v1.QueryEncodeJsonRequest": {
                "properties": {
                    "json": {
                        "type": "string",
                        "description": "JSON string representing a Cosmos SDK message to encode to protobuf bytes."
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Query Encode Json Request",
                "description": "QueryEncodeJsonRequest requests encoding of JSON to protobuf bytes. The JSON must represent a valid Cosmos SDK message that can be unmarshaled."
            }
        }
    },
    "response": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.script.v1.QueryEncodeJsonResponse",
        "definitions": {
            "dysonprotocol.script.v1.QueryEncodeJsonResponse": {
                "properties": {
                    "bytes": {
                        "type": "string",
                        "description": "Protobuf-encoded bytes of the input JSON message.",
                        "format": "binary",
                        "binaryEncoding": "base64"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Query Encode Json Response",
                "description": "QueryEncodeJsonResponse contains the protobuf-encoded bytes."
            }
        }
    }
}