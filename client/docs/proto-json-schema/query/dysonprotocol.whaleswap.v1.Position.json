{
    "request": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.QueryPositionRequest",
        "definitions": {
            "dysonprotocol.whaleswap.v1.QueryPositionRequest": {
                "properties": {
                    "position_id": {
                        "type": "string",
                        "description": "ID of the leverage position to retrieve"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Query Position Request"
            }
        }
    },
    "response": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.QueryPositionResponse",
        "definitions": {
            "dysonprotocol.whaleswap.v1.QueryPositionResponse": {
                "properties": {
                    "position": {
                        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.LeveragePosition",
                        "additionalProperties": false
                    },
                    "health_status": {
                        "enum": [
                            "POSITION_HEALTH_STATUS_UNSPECIFIED",
                            0,
                            "POSITION_HEALTH_STATUS_HEALTHY",
                            1,
                            "POSITION_HEALTH_STATUS_AT_RISK",
                            2,
                            "POSITION_HEALTH_STATUS_LIQUIDATABLE",
                            3
                        ],
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "integer"
                            }
                        ],
                        "title": "Position Health Status",
                        "description": "HealthStatus enum for position health"
                    },
                    "current_collateral_ratio": {
                        "type": "string"
                    },
                    "liquidation_threshold": {
                        "type": "string"
                    },
                    "collateral_value": {
                        "type": "string"
                    },
                    "debt_with_interest": {
                        "type": "string"
                    },
                    "can_close_by_owner": {
                        "type": "boolean"
                    },
                    "blocks_until_closeable": {
                        "type": "string"
                    },
                    "can_initialize_liquidation": {
                        "type": "boolean"
                    },
                    "can_finalize_liquidation": {
                        "type": "boolean"
                    },
                    "interest": {
                        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.InterestView",
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Query Position Response"
            },
            "cosmos.base.v1beta1.Coin": {
                "properties": {
                    "denom": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Coin",
                "description": "Coin defines a token with a denomination and an amount. NOTE: The amount field is an Int which implements the custom method signatures required by gogoproto."
            },
            "cosmos.base.v1beta1.DecCoin": {
                "properties": {
                    "denom": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Dec Coin",
                "description": "DecCoin defines a token with a denomination and a decimal amount. NOTE: The amount field is an Dec which implements the custom method signatures required by gogoproto."
            },
            "dysonprotocol.whaleswap.v1.InterestView": {
                "properties": {
                    "interest_due": {
                        "type": "string",
                        "description": "Decimal amount of interest owed right now (borrowed denom)."
                    },
                    "total_repayment": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false,
                        "description": "Principal + interest as integer coin."
                    },
                    "time_elapsed": {
                        "type": "string",
                        "description": "Seconds since the last settlement reference."
                    },
                    "annual_rate": {
                        "type": "string",
                        "description": "Annual rate applied for this position (borrowed denom entry)."
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Interest View"
            },
            "dysonprotocol.whaleswap.v1.LeveragePosition": {
                "properties": {
                    "position_id": {
                        "type": "string"
                    },
                    "pool_id": {
                        "type": "string"
                    },
                    "user": {
                        "type": "string"
                    },
                    "status": {
                        "enum": [
                            "POSITION_STATUS_UNSPECIFIED",
                            0,
                            "POSITION_STATUS_OPEN",
                            1,
                            "POSITION_STATUS_CLOSED",
                            2,
                            "POSITION_STATUS_LIQUIDATING",
                            3,
                            "POSITION_STATUS_LIQUIDATED",
                            4
                        ],
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "integer"
                            }
                        ],
                        "title": "Position Status"
                    },
                    "borrowed": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false
                    },
                    "held": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false
                    },
                    "collateral": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false
                    },
                    "created_height": {
                        "type": "string"
                    },
                    "created_time": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "liquidation_initialized_block_height": {
                        "type": "string"
                    },
                    "liquidation_status": {
                        "enum": [
                            "LIQUIDATION_STATUS_UNSPECIFIED",
                            0,
                            "LIQUIDATION_STATUS_NONE",
                            1,
                            "LIQUIDATION_STATUS_INITIALIZED",
                            2
                        ],
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "integer"
                            }
                        ],
                        "title": "\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n Leverage State Types\n \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550",
                        "description": "\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 Leverage State Types \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550"
                    },
                    "accrued_interest": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false,
                        "description": "Unpaid interest carried forward from prior settlements (borrowed denom)."
                    },
                    "updated_height": {
                        "type": "string"
                    },
                    "updated_time": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "interest_rate": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.DecCoin"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "\u2550\u2550\u2550\u2550\u2550 PER-POSITION SNAPSHOTS (sticky to this position) \u2550\u2550\u2550\u2550\u2550 Annual interest rates per reserve denom (exactly two, canonical order). Each amount is a LegacyDec string representing APR (per-year accrual)."
                    },
                    "min_collateral_ratio": {
                        "type": "string",
                        "description": "Minimum collateral ratio used for health/liquidation checks (cosmos.Dec string)."
                    },
                    "liquidation_threshold": {
                        "type": "string",
                        "description": "Liquidation threshold used for liquidation checks (cosmos.Dec string)."
                    },
                    "initial_borrowed": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false,
                        "description": "Opening principal snapshot for analytics/limits (borrowed denom)."
                    },
                    "total_interest_paid": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false,
                        "description": "Lifetime interest paid by the user (borrowed denom)."
                    },
                    "last_interest_settlement_time": {
                        "type": "string",
                        "description": "Timestamp of the last time interest was settled into accrued_interest.",
                        "format": "date-time"
                    },
                    "accrued_interest_remainder": {
                        "type": "string",
                        "description": "Fractional interest remainder (<1 borrowed coin) preserved between settlements."
                    },
                    "trade_ids": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "description": "Trade IDs associated with this position over its lifetime. Semantics: - Includes the opening trade that created the position. - Includes all trades from partial and full closes. - Includes trades from liquidation paths. - Includes trades from MsgCoverPosition (covers) auto-close path. Values are whaleswap Trade.trade_id (uint64)."
                    },
                    "total_realized_profit": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false,
                        "description": "\u2550\u2550\u2550\u2550\u2550 REALIZED P&L (PER POSITION) \u2550\u2550\u2550\u2550\u2550 Cumulative realized profit from this position over its lifetime, denominated in the borrowed denom. Includes: - Profits from ClosePosition (full and partial closes) - Profits from MsgCoverPosition auto-close path"
                    },
                    "total_realized_loss": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false,
                        "description": "Cumulative realized loss from this position over its lifetime, denominated in the borrowed denom. Includes: - Losses realized in ClosePosition (full and partial closes) - Losses realized during liquidation flows (if any)"
                    },
                    "collateral_returned": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false,
                        "description": "\u2550\u2550\u2550\u2550\u2550 FINAL COLLATERAL RETURNED \u2550\u2550\u2550\u2550\u2550 The amount of collateral returned to the user when the position was fully closed. For partial closes, this accumulates the returned amount."
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Leverage Position",
                "description": "LeveragePosition represents an active leverage position for a trader."
            }
        }
    }
}