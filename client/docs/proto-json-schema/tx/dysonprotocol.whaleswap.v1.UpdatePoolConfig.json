{
    "request": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgUpdatePoolConfig",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgUpdatePoolConfig": {
                "properties": {
                    "signer": {
                        "type": "string"
                    },
                    "pool_id": {
                        "type": "string"
                    },
                    "fee_pct": {
                        "type": "string",
                        "description": "Optional fields; empty string means no change  cosmos.Dec string"
                    },
                    "min_price": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array"
                    },
                    "max_price": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array"
                    },
                    "min_collateral_ratio": {
                        "type": "string",
                        "description": "Leverage configuration (optional; empty means no change)  cosmos.Dec string"
                    },
                    "max_leverage_ratio": {
                        "type": "string",
                        "description": "cosmos.Dec string"
                    },
                    "max_borrow_percent": {
                        "type": "string",
                        "description": "cosmos.Dec string"
                    },
                    "interest_rate_coin1": {
                        "type": "string",
                        "description": "Annual interest rates per reserve coin (optional; empty means no change) Example: \"0.10\" for 10% APR  cosmos.Dec string"
                    },
                    "interest_rate_coin2": {
                        "type": "string",
                        "description": "cosmos.Dec string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Update Pool Config",
                "description": "Update pool config (owner-only: majority of shares > 50%). Notes: - Empty string/empty arrays indicate no change for that field. - Price bands follow the same two-coin ratio rules as in MsgCreatePool."
            },
            "cosmos.base.v1beta1.Coin": {
                "properties": {
                    "denom": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Coin",
                "description": "Coin defines a token with a denomination and an amount. NOTE: The amount field is an Int which implements the custom method signatures required by gogoproto."
            }
        }
    },
    "response": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgUpdatePoolConfigResponse",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgUpdatePoolConfigResponse": {
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Update Pool Config Response"
            }
        }
    }
}