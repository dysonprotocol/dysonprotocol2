{
    "request": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgMakeTrade",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgMakeTrade": {
                "properties": {
                    "trader": {
                        "type": "string"
                    },
                    "max_input": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "End-of-tx debit caps per denom for the trader"
                    },
                    "operations": {
                        "items": {
                            "$ref": "#/definitions/dysonprotocol.whaleswap.v1.TradeOperation"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "Mixed operations processed in-order"
                    },
                    "min_output": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "Final trader minimum outputs per denom after aggregation"
                    },
                    "note": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Make Trade"
            },
            "cosmos.base.v1beta1.Coin": {
                "properties": {
                    "denom": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Coin",
                "description": "Coin defines a token with a denomination and an amount. NOTE: The amount field is an Int which implements the custom method signatures required by gogoproto."
            },
            "dysonprotocol.whaleswap.v1.AuctionRedeem": {
                "properties": {
                    "auction_id": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Auction Redeem",
                "description": "AuctionRedeem operation for recording auction redemption in Trade history"
            },
            "dysonprotocol.whaleswap.v1.SwapLeg": {
                "properties": {
                    "pool_id": {
                        "type": "string"
                    },
                    "swap_in": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false,
                        "description": "One of swap_in or swap_out must be set; both allowed for rate constraint"
                    },
                    "swap_out": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Swap Leg"
            },
            "dysonprotocol.whaleswap.v1.TakeItem": {
                "properties": {
                    "offer_id": {
                        "type": "string"
                    },
                    "take_units": {
                        "type": "string",
                        "description": "units to take (sdk.Int string). If empty, take full remaining."
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Take Item"
            },
            "dysonprotocol.whaleswap.v1.TradeOperation": {
                "properties": {
                    "swap": {
                        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.SwapLeg",
                        "additionalProperties": false
                    },
                    "take": {
                        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.TakeItem",
                        "additionalProperties": false
                    },
                    "auction": {
                        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.AuctionRedeem",
                        "additionalProperties": false
                    },
                    "sent": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false,
                        "description": "Execution results (populated when recording Trade):"
                    },
                    "received": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Trade Operation",
                "description": "TradeOperation allows mixing pool swap legs, orderbook takes, and auction redemptions. When stored in Trade.operations, sent/received fields are populated with execution results. When used in MsgMakeTrade.operations, sent/received are empty (populated during execution)."
            }
        }
    },
    "response": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgMakeTradeResponse",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgMakeTradeResponse": {
                "properties": {
                    "amount_out": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Make Trade Response"
            },
            "cosmos.base.v1beta1.Coin": {
                "properties": {
                    "denom": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Coin",
                "description": "Coin defines a token with a denomination and an amount. NOTE: The amount field is an Int which implements the custom method signatures required by gogoproto."
            }
        }
    }
}