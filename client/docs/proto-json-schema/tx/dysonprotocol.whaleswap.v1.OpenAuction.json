{
    "request": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgOpenAuction",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgOpenAuction": {
                "properties": {
                    "seller": {
                        "type": "string"
                    },
                    "bid_denom": {
                        "type": "string"
                    },
                    "sell": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false,
                        "description": "Explicit sell coin to escrow from seller \u2192 module."
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Open Auction",
                "description": "Open an auction by escrowing exactly one coin amount. - The escrowed `sell` coin is transferred from seller to module and marked by   an NFT for redemption logic. `bid_denom` defines the quote asset."
            },
            "cosmos.base.v1beta1.Coin": {
                "properties": {
                    "denom": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Coin",
                "description": "Coin defines a token with a denomination and an amount. NOTE: The amount field is an Int which implements the custom method signatures required by gogoproto."
            }
        }
    },
    "response": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgOpenAuctionResponse",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgOpenAuctionResponse": {
                "properties": {
                    "auction_id": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Open Auction Response"
            }
        }
    }
}