{
    "request": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgPoolSwap",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgPoolSwap": {
                "properties": {
                    "trader": {
                        "type": "string"
                    },
                    "max_input": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "End-of-tx debit caps per denom (vector cap). Missing denom implies 0. Applied after aggregating all legs; tx fails if any denom's required debit exceeds its cap."
                    },
                    "legs": {
                        "items": {
                            "$ref": "#/definitions/dysonprotocol.whaleswap.v1.SwapLeg"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "Arbitrary set of swap legs; order does not need to be contiguous by denom. Output-side fee is applied per leg based on the output denom."
                    },
                    "min_output": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "Final minimum outputs required per denom after aggregation."
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Pool Swap"
            },
            "cosmos.base.v1beta1.Coin": {
                "properties": {
                    "denom": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Coin",
                "description": "Coin defines a token with a denomination and an amount. NOTE: The amount field is an Int which implements the custom method signatures required by gogoproto."
            },
            "dysonprotocol.whaleswap.v1.SwapLeg": {
                "properties": {
                    "pool_id": {
                        "type": "string"
                    },
                    "swap_in": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false,
                        "description": "Exactly one of swap_in (exact-in) or swap_out (exact-out) must be set. Use message-level min_output for rate constraints across legs."
                    },
                    "swap_out": {
                        "$ref": "#/definitions/cosmos.base.v1beta1.Coin",
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Swap Leg"
            }
        }
    },
    "response": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgPoolSwapResponse",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgPoolSwapResponse": {
                "properties": {
                    "amount_out": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Pool Swap Response"
            },
            "cosmos.base.v1beta1.Coin": {
                "properties": {
                    "denom": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Coin",
                "description": "Coin defines a token with a denomination and an amount. NOTE: The amount field is an Int which implements the custom method signatures required by gogoproto."
            }
        }
    }
}