{
    "request": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgTakeOffer",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgTakeOffer": {
                "properties": {
                    "taker": {
                        "type": "string"
                    },
                    "trades": {
                        "items": {
                            "$ref": "#/definitions/dysonprotocol.whaleswap.v1.TakeItem"
                        },
                        "additionalProperties": false,
                        "type": "array"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Take Offer"
            },
            "dysonprotocol.whaleswap.v1.TakeItem": {
                "properties": {
                    "offer_id": {
                        "type": "string"
                    },
                    "take_units": {
                        "type": "string",
                        "description": "units to take (sdk.Int string). If empty, take full remaining."
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Take Item"
            }
        }
    },
    "response": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgTakeOfferResponse",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgTakeOfferResponse": {
                "properties": {
                    "sent": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "Total coins the taker sent across executed trades (usually want denom)."
                    },
                    "received": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "Total coins the taker received across executed trades (usually have denom)."
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Take Offer Response"
            },
            "cosmos.base.v1beta1.Coin": {
                "properties": {
                    "denom": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Coin",
                "description": "Coin defines a token with a denomination and an amount. NOTE: The amount field is an Int which implements the custom method signatures required by gogoproto."
            }
        }
    }
}