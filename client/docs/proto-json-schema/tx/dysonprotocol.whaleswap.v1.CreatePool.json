{
    "request": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgCreatePool",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgCreatePool": {
                "properties": {
                    "creator": {
                        "type": "string"
                    },
                    "coins": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "Two initial reserves as coins; order will be canonicalized internally (by denom lexicographic order)."
                    },
                    "min_price": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array",
                        "description": "Optional price band expressed as ratios coin2/coin1 using two coins. Each must either be empty (unset) or contain exactly two coins whose denoms match the two pool reserve denoms."
                    },
                    "max_price": {
                        "items": {
                            "$ref": "#/definitions/cosmos.base.v1beta1.Coin"
                        },
                        "additionalProperties": false,
                        "type": "array"
                    },
                    "fee_pct": {
                        "type": "string",
                        "description": "cosmos.Dec string in [0,1)"
                    },
                    "min_collateral_ratio": {
                        "type": "string",
                        "description": "cosmos.Dec string (e.g., \"1.5\")"
                    },
                    "max_leverage_ratio": {
                        "type": "string",
                        "description": "cosmos.Dec string (e.g., \"20.0\")"
                    },
                    "max_borrow_percent": {
                        "type": "string",
                        "description": "cosmos.Dec string in [0,1], applies to both coins"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Create Pool",
                "description": "Create a pool. Behavior: - If min_price/max_price are both unset (or effectively encode [0, +\u221e)), the   pool behaves as constant product (v2). - If a finite band is provided, concentrated-liquidity math applies within   [min_price, max_price] where price is coin_b / coin_a (see conventions)."
            },
            "cosmos.base.v1beta1.Coin": {
                "properties": {
                    "denom": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Coin",
                "description": "Coin defines a token with a denomination and an amount. NOTE: The amount field is an Int which implements the custom method signatures required by gogoproto."
            }
        }
    },
    "response": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "$ref": "#/definitions/dysonprotocol.whaleswap.v1.MsgCreatePoolResponse",
        "definitions": {
            "dysonprotocol.whaleswap.v1.MsgCreatePoolResponse": {
                "properties": {
                    "pool_id": {
                        "type": "string"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "title": "Msg Create Pool Response"
            }
        }
    }
}